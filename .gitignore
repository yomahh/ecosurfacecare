cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Production build
dist/

# Environment variables
.env
.env.*
!.env.example

# Cloudflare
.wrangler/
.dev.vars

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/settings.json
.idea/

# Operating system
.DS_Store
Thumbs.db
EOF
